# Auto-detect text files
* text=auto

# Unity text files
*.wlt text eol=lf

# Unity YAML files
*.meta       text eol=lf
*.unity      text eol=lf
*.prefab     text eol=lf
*.asset      text eol=lf
*.mat        text eol=lf
*.anim       text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
*.physicMaterial text eol=lf
*.physicsMaterial2D text eol=lf
*.playable   text eol=lf
*.mask       text eol=lf

# C# / source files
*.cs         text eol=lf
*.shader     text eol=lf
*.compute    text eol=lf
*.cginc      text eol=lf
*.hlsl       text eol=lf

# Configuration
*.json         text eol=lf
*.inputactions text eol=lf
*.asmdef       text eol=lf
*.asmref       text eol=lf
*.xml          text eol=lf
*.yaml         text eol=lf
*.yml          text eol=lf

# Documentation
*.md  text eol=lf
*.txt text eol=lf

# Binary files
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.tga  binary
*.psd  binary
*.fbx  binary
*.obj  binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.mp4  binary
*.mov  binary
*.dll  binary
*.so   binary
*.dylib binary
*.exe  binary
*.zip  binary
*.7z   binary